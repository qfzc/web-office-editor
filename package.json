{
  "name": "@qfzc/frontend-sdk",
  "version": "0.1.1",
  "description": "Framework-agnostic browser SDK for editing DOCX, XLSX, and PPTX files.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_INTEGRATION_GUIDE.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "docx",
    "xlsx",
    "pptx",
    "document-editor",
    "sdk"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qfzc/web-office-editor.git"
  },
  "bugs": {
    "url": "https://github.com/qfzc/web-office-editor/issues"
  },
  "homepage": "https://github.com/qfzc/web-office-editor#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@docx-editor.dev/core": "2.6.0",
    "@docx-editor.dev/react": "2.6.0",
    "@fortune-sheet/core": "1.0.4",
    "@fortune-sheet/react": "1.0.4",
    "events": "3.3.0",
    "pptx-vanilla-viewer": "1.22.3",
    "react": "18.3.1",
    "react-dom": "19.2.8",
    "stream-browserify": "3.0.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@types/node": "22.17.2",
    "@types/react": "18.3.23",
    "@types/react-dom": "19.2.5",
    "eslint": "9.33.0",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.40.0",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "fast-uri": "3.1.6",
    "qs": "6.16.0",
    "uuid": "11.1.1"
  }
}
